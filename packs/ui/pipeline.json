{
  "schema_version": "0.1",
  "pipeline": "ui-pack",
  "description": "UI pack pipeline: planning DESIGN PASS requires a current, content-bound contract receipt; TICKETS rechecks its freshness if the collector condition is active. Place contract.json, docs/, design-receipt.json and packs/ui/ in the project root (or customize the DESIGN gate_receipt paths).",
  "stages": [
    {
      "id": "DISCOVERY",
      "kind": "planning",
      "gate_verdicts": [
        "PASS",
        "FIX_REQUIRED",
        "USER_DECISION_REQUIRED"
      ],
      "next": "SPEC",
      "entry": true
    },
    {
      "id": "SPEC",
      "kind": "planning",
      "gate_verdicts": [
        "PASS",
        "FIX_REQUIRED",
        "USER_DECISION_REQUIRED"
      ],
      "next": "DESIGN"
    },
    {
      "id": "DESIGN",
      "kind": "planning",
      "gate_verdicts": [
        "PASS",
        "FIX_REQUIRED",
        "USER_DECISION_REQUIRED"
      ],
      "next": "TICKETS",
      "conditional": true,
      "condition": "golden_path_declares_collector",
      "gate_receipt": {
        "path": "design-receipt.json",
        "source": "contract.json",
        "documents": "docs",
        "engine_root": "packs/ui",
        "engine_patterns": [
          "ui_design_harness/*.py",
          "schemas/contract.schema.json"
        ],
        "stage": "design"
      }
    },
    {
      "id": "TICKETS",
      "kind": "planning",
      "gate_verdicts": [
        "PASS",
        "FIX_REQUIRED",
        "USER_DECISION_REQUIRED"
      ],
      "next": "IMPLEMENTATION",
      "on_gate_pass": [
        "validate_ticket_dependencies",
        "require_conditional_gates"
      ]
    },
    {
      "id": "IMPLEMENTATION",
      "kind": "execution",
      "next": "REVIEW",
      "on_enter": "start_first_ticket"
    },
    {
      "id": "REVIEW",
      "kind": "execution",
      "next": null,
      "terminal": true,
      "required_evidence_tiers": [
        "deterministic",
        "captured",
        "declared"
      ]
    }
  ]
}
