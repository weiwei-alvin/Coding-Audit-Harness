{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Design Harness Contract 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "design": {
      "$ref": "#/$defs/design"
    }
  },
  "required": [
    "schema_version",
    "metadata",
    "project",
    "brief"
  ],
  "additionalProperties": false,
  "$defs": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PRJ-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "platform": {
          "enum": [
            "web",
            "desktop",
            "mobile"
          ]
        },
        "kind": {
          "enum": [
            "operational",
            "brand",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "platform",
        "kind"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "established_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updated_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "established_date",
        "updated_date",
        "version"
      ],
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^USR-[0-9]{3}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "role",
        "context",
        "task_ids"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{3}$"
        },
        "user_id": {
          "type": "string",
          "pattern": "^USR-[0-9]{3}$"
        },
        "frequency": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "flow_id": {
          "type": "string",
          "pattern": "^FLOW-[0-9]{3}$"
        }
      },
      "required": [
        "id",
        "user_id",
        "frequency",
        "trigger",
        "outcome",
        "flow_id"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OBJ-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FLOW-[0-9]{3}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{3}$"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "action",
              "result"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "task_id",
        "steps",
        "exceptions"
      ],
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[0-9]{3}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "blocking": {
          "type": "boolean"
        },
        "resolution": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "question",
        "blocking",
        "resolution",
        "reason"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SUCCESS-[0-9]{3}$"
        },
        "measure": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "threshold": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "measure",
        "threshold",
        "verification"
      ],
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user"
          },
          "minItems": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          },
          "minItems": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          },
          "minItems": 1
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          },
          "minItems": 1
        },
        "data_density": {
          "type": "object",
          "properties": {
            "typical_records": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_records": {
              "type": "integer",
              "minimum": 0
            },
            "primary_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "typical_records",
            "maximum_records",
            "primary_fields",
            "rationale"
          ],
          "additionalProperties": false
        },
        "platform_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/success"
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "statement",
              "validation"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          },
          "minItems": 0
        }
      },
      "required": [
        "problem",
        "users",
        "tasks",
        "objects",
        "flows",
        "data_density",
        "platform_constraints",
        "success_criteria",
        "assumptions",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SCR-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "flow_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FLOW-[0-9]{3}$"
          },
          "minItems": 1
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^OBJ-[0-9]{3}$"
          },
          "minItems": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "default",
                  "loading",
                  "empty",
                  "error",
                  "success",
                  "validation_error",
                  "disabled"
                ]
              },
              "presentation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "interaction": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "kind",
              "presentation",
              "interaction"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "state_exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "default",
                  "loading",
                  "empty",
                  "error",
                  "success",
                  "validation_error",
                  "disabled"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "kind",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "wireframe": {
          "type": "object",
          "properties": {
            "format": {
              "const": "text"
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "format",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "flow_ids",
        "object_ids",
        "states",
        "state_exclusions",
        "wireframe"
      ],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^US-[0-9]{3}$"
        },
        "user_id": {
          "type": "string",
          "pattern": "^USR-[0-9]{3}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "screen_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SCR-[0-9]{3}$"
          },
          "minItems": 1
        },
        "ac_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UI-AC-[0-9]{3}$"
          },
          "minItems": 1
        },
        "success_criteria_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SUCCESS-[0-9]{3}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "user_id",
        "task_id",
        "statement",
        "screen_ids",
        "ac_ids",
        "success_criteria_ids"
      ],
      "additionalProperties": false
    },
    "ac": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UI-AC-[0-9]{3}$"
        },
        "story_id": {
          "type": "string",
          "pattern": "^US-[0-9]{3}$"
        },
        "screen_id": {
          "type": "string",
          "pattern": "^SCR-[0-9]{3}$"
        },
        "state": {
          "enum": [
            "default",
            "loading",
            "empty",
            "error",
            "success",
            "validation_error",
            "disabled"
          ]
        },
        "given": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "then": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "enum": [
            "automated",
            "manual",
            "hybrid"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "procedure": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "artifact",
            "procedure"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "story_id",
        "screen_id",
        "state",
        "given",
        "when",
        "then",
        "method",
        "required",
        "evidence"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "stories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/story"
          },
          "minItems": 1
        },
        "screens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/screen"
          },
          "minItems": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ac"
          },
          "minItems": 1
        },
        "information_architecture": {
          "type": "object",
          "properties": {
            "entry_screen_id": {
              "type": "string",
              "pattern": "^SCR-[0-9]{3}$"
            },
            "navigation": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "screen_id": {
                    "type": "string",
                    "pattern": "^SCR-[0-9]{3}$"
                  },
                  "parent_screen_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^SCR-[0-9]{3}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "screen_id",
                  "parent_screen_id",
                  "label"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "entry_screen_id",
            "navigation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "stories",
        "screens",
        "acceptance_criteria",
        "information_architecture"
      ],
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TOK-[0-9]{3}$"
        },
        "category": {
          "enum": [
            "color",
            "typography",
            "spacing",
            "layout",
            "motion"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "category",
        "name",
        "value",
        "rationale"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CMP-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "screen_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SCR-[0-9]{3}$"
          },
          "minItems": 1
        },
        "state_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "default",
              "loading",
              "empty",
              "error",
              "success",
              "validation_error",
              "disabled"
            ]
          },
          "minItems": 1
        },
        "token_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TOK-[0-9]{3}$"
          },
          "minItems": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "keyboard": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accessible_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^CMP-[0-9]{3}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "screen_ids",
        "state_kinds",
        "token_ids",
        "behavior",
        "keyboard",
        "accessible_name",
        "parent_id"
      ],
      "additionalProperties": false
    },
    "responsive": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RESP-[0-9]{3}$"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "input": {
              "type": "array",
              "items": {
                "enum": [
                  "keyboard",
                  "mouse",
                  "touch"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "label",
            "width",
            "height",
            "input"
          ],
          "additionalProperties": false
        },
        "screen_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SCR-[0-9]{3}$"
          },
          "minItems": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "viewport",
        "screen_ids",
        "behavior",
        "verification"
      ],
      "additionalProperties": false
    },
    "a11y": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AX-[0-9]{3}$"
        },
        "screen_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SCR-[0-9]{3}$"
          },
          "minItems": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "enum": [
            "automated",
            "manual",
            "hybrid"
          ]
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "screen_ids",
        "rule",
        "method",
        "verification"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RV-[0-9]{3}$"
        },
        "category": {
          "enum": [
            "art_direction",
            "design_system",
            "anti_generic",
            "responsive",
            "accessibility"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "procedure": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RULE-[0-9]{3}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "category",
        "required",
        "procedure",
        "evidence",
        "rule_ids"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "art_direction": {
          "type": "object",
          "properties": {
            "route": {
              "enum": [
                "restrained",
                "distinctive"
              ]
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "status": {
