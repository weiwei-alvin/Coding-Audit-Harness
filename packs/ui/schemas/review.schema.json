{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Design Harness Review Record 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "ui_review_record"
    },
    "review_round": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "properties": {
        "rules_receipt": {
          "$ref": "#/$defs/evidence_ref"
        },
        "collector_manifest": {
          "$ref": "#/$defs/evidence_ref"
        }
      },
      "required": [
        "rules_receipt",
        "collector_manifest"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "tiers": {
      "$ref": "#/$defs/tiers"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "review_round",
    "reviewer",
    "evidence",
    "findings",
    "tiers"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding_key": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "rules",
            "manual"
          ]
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "disposition_rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "finding_key",
        "source",
        "summary"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "rules"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "severity": false,
              "evidence_ref": false,
              "scope_files": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "manual"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "severity",
              "evidence_ref",
              "scope_files"
            ]
          }
        }
      ]
    },
    "tiers": {
      "type": "object",
      "properties": {
        "deterministic": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "captured": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "collected",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "reviewed"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "reviewed_by"
                ]
              }
            }
          ]
        },
        "declared": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string",
                "minLength": 1
              },
              "judgment": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "criterion",
              "source",
              "limitations",
              "judgment"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "deterministic",
        "captured",
        "declared"
      ],
      "additionalProperties": false
    }
  }
}
