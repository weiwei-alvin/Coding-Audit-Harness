{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Design Harness Deterministic Rules 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "ruleset": {
      "type": "string",
      "minLength": 1
    },
    "compiled_at": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_repo"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "ruleset",
    "compiled_at",
    "sources",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "source_repo": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "url",
        "commit",
        "observed",
        "license",
        "notes"
      ],
      "additionalProperties": false
    },
    "rule_source": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "entry",
        "url",
        "commit",
        "observed"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SLOP|WIG)-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor"
          ]
        },
        "kind": {
          "enum": [
            "forbidden",
            "required_when",
            "distinct_threshold"
          ]
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "minItems": 1
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "require": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/rule_source"
        }
      },
      "required": [
        "id",
        "title",
        "severity",
        "kind",
        "applies_to",
        "message",
        "remediation",
        "source"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "forbidden"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "patterns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "required_when"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "when",
              "require"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "distinct_threshold"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "patterns",
              "threshold"
            ]
          }
        }
      ]
    }
  }
}
